
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bhas Karmarkar</title>
  <meta name="description" content="Bhas Karmarkar — Robotics Engineer, Traveller and geopolitics enthusiast." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    :root {
      --bg:       #faf8f5;
      --bg2:      #f0ebe3;
      --ink:      #1a1614;
      --ink2:     #4a4541;
      --muted:    #8a8480;
      --red:      #c44536;
      --gold:     #c8973a;
      --line:     #e0d5c7;
      --mono:     'DM Mono', monospace;
      --serif:    'Cormorant Garamond', serif;
      --serif-hd: 'Libre Baskerville', serif;
      --pad:      clamp(1.2rem, 5vw, 3rem);
      --max:      1100px;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--serif);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      font-size: 18px;
      overflow-x: hidden;
    }
    ::selection { background: var(--gold); color: #fff; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 200;
      height: 56px; display: flex; align-items: center;
      justify-content: space-between; padding: 0 var(--pad);
      background: rgba(250,248,245,0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.3s;
    }
    nav.scrolled { border-bottom-color: var(--line); }
    .brand {
      font-family: var(--mono); font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.16em; text-transform: uppercase;
      text-decoration: none; color: var(--ink);
    }
    .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
    .nav-links a {
      font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.12em;
      text-transform: uppercase; text-decoration: none;
      color: var(--muted); transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--ink); }
    .nav-links a.on { color: var(--ink); }
    .nav-cta {
      font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.1em;
      text-transform: uppercase; padding: 0.45rem 1rem;
      border: 1px solid var(--ink); color: var(--ink);
      text-decoration: none; transition: all 0.2s;
    }
    .nav-cta:hover { background: var(--ink); color: var(--bg); }

    /* ── HERO ── */
    .hero {
      min-height: 100svh;
      display: grid;
      grid-template-rows: 1fr auto;
      padding-top: 56px;
      position: relative;
      overflow: hidden;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 4rem;
      align-items: center;
      padding: 5rem var(--pad) 4rem;
      max-width: var(--max);
      margin: 0 auto;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .hero-text { display: flex; flex-direction: column; }

    .hero-photo-col {
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      animation: fadeUp 0.8s ease 0.35s both;
    }
    .hero-photo {
      width: 100%;
      max-width: 320px;
      aspect-ratio: 4/5;
      object-fit: cover;
      object-position: top;
      display: block;
      border: 1px solid var(--line);
      filter: grayscale(8%);
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow {
      font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--red);
      display: flex; align-items: center; gap: 0.8rem;
      margin-bottom: 2rem;
      animation: fadeUp 0.7s ease 0.1s both;
    }
    .status-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #22c55e; box-shadow: 0 0 8px #22c55e;
      animation: pulse 2.4s ease-in-out infinite; flex-shrink: 0;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.3;transform:scale(0.8)} }

    .hero-name {
      font-family: var(--serif-hd);
      font-size: clamp(3.4rem, 8vw, 7.2rem);
      font-weight: 700; line-height: 1.0;
      letter-spacing: -0.03em; color: var(--ink);
      margin-bottom: 1.6rem;
      animation: fadeUp 0.8s ease 0.25s both;
    }
    .hero-name em {
      font-style: italic; font-weight: 400;
      font-family: var(--serif); color: var(--red);
    }

    .hero-desc {
      font-family: var(--serif); font-style: italic;
      font-size: clamp(1.05rem, 2.2vw, 1.4rem);
      color: var(--ink2); font-weight: 300;
      max-width: 480px; line-height: 1.75;
      margin-bottom: 2.8rem;
      animation: fadeUp 0.7s ease 0.4s both;
    }

    .hero-actions {
      display: flex; gap: 1rem; flex-wrap: wrap;
      animation: fadeUp 0.6s ease 0.55s both;
    }

    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--mono); font-size: 0.64rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.75rem 1.6rem; text-decoration: none;
      border: 1px solid var(--line);
      transition: all 0.22s; color: var(--ink);
      background: transparent; cursor: pointer;
    }
    .btn:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .btn-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .btn-primary:hover { background: var(--red); border-color: var(--red); }

    /* ── PHOTO STRIP ── */
    .photo-strip {
      width: 100%; overflow: hidden;
      border-top: 1px solid var(--line);
      animation: fadeUp 0.8s ease 0.7s both;
    }
    .strip-track {
      display: flex; gap: 0;
      width: max-content;
      animation: strip-scroll 110s linear infinite;
    }
    .strip-track:hover { animation-play-state: paused; }
    @keyframes strip-scroll {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .strip-img {
      width: clamp(160px, 20vw, 260px);
      height: clamp(130px, 16vw, 190px);
      object-fit: cover; display: block;
      filter: grayscale(20%) brightness(0.96);
      transition: filter 0.3s;
      flex-shrink: 0;
    }
    .strip-img:hover { filter: grayscale(0%) brightness(1.04); }

    /* ── GATEWAY CARDS ── */
    .gateway {
      padding: 5rem var(--pad);
      max-width: var(--max); margin: 0 auto;
    }
    .gateway-label {
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--muted);
      margin-bottom: 2.5rem;
      display: flex; align-items: center; gap: 0.8rem;
    }
    .gateway-label::after { content: ''; flex: 1; height: 1px; background: var(--line); max-width: 60px; }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: var(--line);
      border: 1px solid var(--line);
    }
    .card {
      background: var(--bg);
      padding: 2.8rem 2rem;
      text-decoration: none; color: inherit;
      display: flex; flex-direction: column;
      gap: 1.2rem;
      transition: background 0.25s;
      position: relative; overflow: hidden;
    }
    .card::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0;
      height: 2px; background: var(--red);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
    }
    .card:hover { background: var(--bg2); }
    .card:hover::after { transform: scaleX(1); }

    .card-num {
      font-family: var(--mono); font-size: 0.58rem;
      letter-spacing: 0.2em; color: var(--muted);
      text-transform: uppercase;
    }
    .card-title {
      font-family: var(--serif-hd);
      font-size: 1.6rem; font-weight: 700;
      color: var(--ink); line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .card-title em {
      font-style: italic; font-weight: 400;
      font-family: var(--serif);
    }
    .card-desc {
      font-family: var(--serif); font-style: italic;
      font-size: 0.95rem; color: var(--ink2);
      line-height: 1.7; font-weight: 300; flex: 1;
    }
    .card-arrow {
      font-family: var(--mono); font-size: 0.62rem;
      color: var(--gold); letter-spacing: 0.1em;
      margin-top: auto; display: flex; align-items: center; gap: 0.4rem;
      transition: gap 0.2s;
    }
    .card:hover .card-arrow { gap: 0.8rem; }

    /* ── BRIEF BIO ── */
    .brief {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: var(--bg2);
    }
    .brief-inner {
      max-width: var(--max); margin: 0 auto;
      padding: 4rem var(--pad);
    }

    .brief-kicker {
      font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--red);
      margin-bottom: 1.2rem;
      display: flex; align-items: center; gap: 0.7rem;
    }
    .brief-kicker::before { content: ''; width: 24px; height: 1px; background: var(--red); }
    .brief-heading {
      font-family: var(--serif-hd);
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      font-weight: 700; line-height: 1.15;
      letter-spacing: -0.02em; color: var(--ink);
      margin-bottom: 1.2rem;
    }
    .brief-heading em { font-style: italic; font-weight: 400; font-family: var(--serif); }
    .brief-body {
      font-size: 1rem; color: var(--ink2); line-height: 1.85;
      font-weight: 400; font-style: normal; margin-bottom: 2rem; max-width: 640px;
    }
    .brief-stats {
      display: flex; gap: 2.5rem; flex-wrap: wrap;
      padding-top: 1.5rem; border-top: 1px solid var(--line);
    }
    .bstat-val {
      font-family: var(--serif-hd);
      font-size: 1.8rem; font-weight: 700;
      color: var(--ink); display: block; line-height: 1;
    }
    .bstat-lbl {
      font-family: var(--mono); font-size: 0.58rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--muted); margin-top: 0.35rem;
    }

    /* ── FOOTER ── */
    footer {
      background: var(--ink); color: var(--bg);
      padding: 2rem var(--pad);
      display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 0.5rem;
      font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.08em;
    }
    footer a { color: var(--gold); text-decoration: none; }
    footer a:hover { color: var(--bg); }

    /* ── SCROLL REVEAL ── */
    .reveal {
      opacity: 0; transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── MOBILE ── */
    @media(max-width: 860px) {
      .hero-content { grid-template-columns: 1fr; gap: 2rem; }
      .hero-photo-col { justify-content: flex-start; }
      .hero-photo { max-width: 180px; aspect-ratio: 1; border-radius: 50%; }
      .cards { grid-template-columns: 1fr; }
      .brief-inner { padding: 2.5rem var(--pad); }
    }
    @media(max-width: 600px) {
      nav { height: 52px; padding: 0 1.2rem; }
      .brand { font-size: 0; letter-spacing: 0; }
      .brand::after { content: 'BK'; font-size: 0.78rem; letter-spacing: 0.14em; font-family: var(--mono); color: var(--ink); }
      .nav-links { gap: 1.2rem; }
      .nav-links a { font-size: 0.6rem; }
      .nav-cta { display: none; }
      .hero-content { padding: 2.5rem var(--pad) 2rem; }
      .hero-name { font-size: clamp(2.6rem, 10vw, 4rem); }
      .gateway { padding: 3rem var(--pad); }
      .card { padding: 2rem 1.4rem; }
      .card-title { font-size: 1.3rem; }
      .brief-stats { gap: 1.5rem; }
      .strip-img { width: clamp(130px, 40vw, 200px); height: 130px; }
    }
  </style>
</head>

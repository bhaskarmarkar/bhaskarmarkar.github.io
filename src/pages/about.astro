  function initAccordion() {
    document.querySelectorAll(".sec-btn[data-target]").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.target;
        const section = document.getElementById(id);
        if (!section) return;
        const isOpen = section.classList.contains("open");
        document.querySelectorAll(".section.collapsible").forEach(s => s.classList.remove("open"));
        document.querySelectorAll(".sec-btn[data-target]").forEach(b => b.classList.remove("active"));
        if (!isOpen) {
          section.classList.add("open");
          document.querySelectorAll(`.sec-btn[data-target="${id}"]`).forEach(b => b.classList.add("active"));
          const offset = 56 + 44;
          const top = section.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: "smooth" });
        }
      });
    });
  }

